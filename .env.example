# Sepolia RPC URL from alchemy.com / infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Throwaway wallet that deploys the contract AND signs scores (admin + oracle). Never use a wallet with real funds.
PRIVATE_KEY=0xYOUR_THROWAWAY_PRIVATE_KEY
ETHERSCAN_API_KEY=your_etherscan_key
# Public read-only RPC used by the browser when no wallet is connected
RPC_PUBLIC=https://ethereum-sepolia-rpc.publicnode.com
EXPLORER=https://sepolia.etherscan.io
# Optional: Set DEMO_AUTO_KYC=true to enable 1-click instant demo KYC bypass without Admin MetaMask confirmation
DEMO_AUTO_KYC=false
